{
  "name": "@kylinyz/mcp-abap-abap-adt-api",
  "version": "0.6.0",
  "mcpName": "io.github.kylinyz/mcp-abap-abap-adt-api",
  "main": "dist/index.js",
  "bin": {
    "mcp-abap-abap-adt-api": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/__tests__",
    "docs/evidence/repository-creation-maturity-evidence.json",
    "docs/evidence/repository-creation-ddic-domain-real-dev-verified.md",
    "docs/evidence/repository-creation-data-element-real-dev-verified.md",
    "docs/evidence/repository-creation-table-type-real-dev-verified.md",
    "docs/evidence/repository-creation-wave1-batch-real-dev-verified.md",
    "docs/evidence/repository-creation-wave2-package-interface-typegroup-real-dev-verified.md",
    "docs/evidence/repository-creation-wave2-program-include-real-dev-verified.md",
    "docs/evidence/repository-creation-database-table-real-dev-verified.md",
    "docs/evidence/repository-creation-function-group-real-dev-verified.md",
    "docs/evidence/repository-creation-function-group-include-real-dev-verified.md",
    "docs/evidence/repository-creation-function-module-real-dev-verified.md",
    "docs/evidence/repository-creation-wave3-cds-service-chdo-validation.md",
    "third-party"
  ],
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:sap-dev:readonly": "node ./scripts/sap-dev-readonly-smoke.mjs",
    "test:sap-dev:readonly:ttl": "node ./scripts/sap-dev-readonly-smoke.mjs --verify-ttl",
    "test:sap-dev:session-resilience": "node ./scripts/sap-session-resilience-smoke.mjs",
    "test:repository-productionization-runtime": "node ./scripts/repository-productionization-runtime-smoke.mjs",
    "test:repository-verified-domain-preview": "node ./scripts/repository-verified-domain-preview.mjs",
    "test:adt-timeout": "node ./scripts/adt-timeout-smoke.mjs",
    "check:adt-imports": "node ./scripts/check-adt-imports.mjs",
    "check:repository-creation-coverage": "npm run build --silent && node ./scripts/check-repository-creation-coverage.mjs",
    "audit:eclipse-adt-creation": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/audit-eclipse-adt-creation.ps1",
    "build": "tsc -p tsconfig.json",
    "start": "node ./dist/index.js",
    "dev": "npx @modelcontextprotocol/inspector ./dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "abap",
    "sap",
    "adt",
    "abap-adt-api",
    "mcp",
    "model-context-protocol"
  ],
  "author": "KylinYZ",
  "contributors": [
    "mario-andreschak (original upstream mcp-abap-abap-adt-api)"
  ],
  "description": "MCP server with an embedded ABAP ADT client, guarded development workflows, and read-only diagnostics for SAP systems",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KylinYZ/mcp-abap-adt.git"
  },
  "homepage": "https://github.com/KylinYZ/mcp-abap-adt#readme",
  "bugs": {
    "url": "https://github.com/KylinYZ/mcp-abap-adt/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.4.1",
    "axios": "^1.15.2",
    "dotenv": "^16.4.7",
    "fast-xml-parser": "^5.7.2",
    "fp-ts": "^2.16.7",
    "html-entities": "^2.5.2",
    "io-ts": "^2.2.21",
    "io-ts-reporters": "^2.0.1",
    "sprintf-js": "^1.1.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.10",
    "@types/sprintf-js": "^1.1.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  }
}
